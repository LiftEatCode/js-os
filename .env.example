# Pooled Neon connection for JS OS application runtime.
DATABASE_URL=

# Direct Neon connection for Prisma CLI/database operations.
DIRECT_URL=

# Required by npm run db:bootstrap. Must be "development" on a developer workstation.
# Production bootstrap is not supported by the bootstrap script.
# JS_OS_BOOTSTRAP_TARGET=development

# Temporary Command Center write safeguard (auth will replace this).
# Writes require NODE_ENV=development AND this value equal to "true".
# Default: disabled. For local Goal/Work/Approval/Agent configuration with `next dev`, set true in .env.local.
JS_OS_COMMAND_CENTER_WRITES=false
