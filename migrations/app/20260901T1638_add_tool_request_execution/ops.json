        "description": "create table \"toolRequest\"",
        "sql": "CREATE TABLE \"public\".\"toolRequest\" (\n  \"agentDefinitionId\" uuid,\n  \"agentRunId\" uuid,\n  \"approvalId\" uuid,\n  \"approvalRequirement\" text NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"idempotencyKey\" text,\n  \"input\" jsonb NOT NULL,\n  \"organizationId\" uuid NOT NULL,\n  \"requestedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"requestedById\" text,\n  \"requestedByType\" text NOT NULL,\n  \"requiredPermission\" text NOT NULL,\n  \"riskLevel\" text NOT NULL,\n  \"status\" text NOT NULL,\n  \"toolName\" text NOT NULL,\n  \"toolSlug\" text NOT NULL,\n  \"toolVersion\" int4 NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"workItemId\" uuid,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"toolRequest_approvalRequirement_check_ba5f8288\" CHECK (\"approvalRequirement\" IN ('NEVER', 'ALWAYS')),\n  CONSTRAINT \"toolRequest_requestedByType_check_1048f7e2\" CHECK (\"requestedByType\" IN ('USER', 'AGENT', 'SYSTEM')),\n  CONSTRAINT \"toolRequest_requiredPermission_check_56b6fa72\" CHECK (\"requiredPermission\" IN ('OBSERVE', 'RECOMMEND', 'PREPARE', 'EXECUTE')),\n  CONSTRAINT \"toolRequest_riskLevel_check_a114ba6a\" CHECK (\"riskLevel\" IN ('LOW', 'MEDIUM', 'HIGH', 'CRITICAL')),\n  CONSTRAINT \"toolRequest_status_check_5185bc5a\" CHECK (\"status\" IN ('REQUESTED', 'WAITING_APPROVAL', 'READY', 'FULFILLED', 'FAILED', 'CANCELLED', 'DENIED'))\n)",
