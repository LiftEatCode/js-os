      {
        "description": "create table \"toolExecution\"",
        "sql": "CREATE TABLE \"public\".\"toolExecution\" (\n  \"attemptNumber\" int4 NOT NULL,\n  \"completedAt\" timestamptz,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"error\" text,\n  \"id\" uuid NOT NULL,\n  \"organizationId\" uuid NOT NULL,\n  \"output\" jsonb,\n  \"startedAt\" timestamptz,\n  \"status\" text NOT NULL,\n  \"toolRequestId\" uuid NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"toolExecution_status_check_ec07928c\" CHECK (\"status\" IN ('QUEUED', 'RUNNING', 'SUCCEEDED', 'FAILED', 'CANCELLED'))\n)",
        "params": []
      }
    ],
    "postcheck": [
